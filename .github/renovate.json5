{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    // Every pull request is signed off under the DCO, and the DCO check reads
    // this trailer on Renovate's commits too.
    ":gitSignOff",
  ],

  // The pull request title check requires a typed subject, and Renovate
  // otherwise guesses the commit style from the history.
  "semanticCommits": "enabled",
  "rebaseWhen": "never",
  "timezone": "Etc/UTC",
  "schedule": ["before 6am"],
  // Renovate proposes a release only after it has stood for a week, so a
  // compromised release can be yanked before an automerge takes it. Renovate
  // holds back a release that carries no timestamp.
  "minimumReleaseAge": "7 days",

  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "groupName": "scheduled updates",
      "automerge": true,
    },
    {
      // The release workflow builds in `centos-bootc:stream10` because its
      // glibc is the oldest of the supported rpm bases, and that glibc is the
      // floor of every released binary. An automerged bump of the build base
      // raises the floor without a review. The release
      // workflow asserts the floor as well, so this rule removes the noise
      // rather than the guard.
      "matchDepTypes": ["container"],
      "enabled": false,
    },
  ],
}
